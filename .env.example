# Copia este archivo a .env y ajusta los valores.

# --- Django ---
# En producción usa una clave aleatoria de al menos 32 caracteres
# (con ella se firman también los tokens JWT del frontend).
DJANGO_SECRET_KEY=cambia-esta-clave
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Autenticación ---
# Orígenes del frontend (SPA en otro dominio). Separados por comas.
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Activar solo si el refresh token viaja en cookie httpOnly.
CORS_ALLOW_CREDENTIALS=False
# Vida de los tokens JWT. JWT_ACCESS_MINUTOS=720 son 12 horas.
JWT_ACCESS_MINUTOS=720
JWT_REFRESH_DIAS=7

# --- Base de datos (PostgreSQL) ---
# Obligatorio. Formato: postgres://usuario:clave@host:puerto/nombre_bd
# El host puede ser una IP o dominio si el servicio está en otra máquina.
DATABASE_URL=postgres://usuario:clave@host:5432/nobelio

# --- DIAN ---
# El ambiente contra el que se emite lo decide cada emisor
# (ambiente_facturacion / ambiente_nomina), no el despliegue. DIAN_ENVIRONMENT
# solo fija con cuál nace un emisor nuevo y vale 2 si no se define; ponlo aquí
# únicamente si quieres que los emisores nuevos nazcan en producción.
DIAN_WSDL_HABILITACION=https://vpfe-hab.dian.gov.co/WcfDianCustomerServices.svc?wsdl
DIAN_WSDL_PRODUCCION=https://vpfe.dian.gov.co/WcfDianCustomerServices.svc?wsdl
DIAN_POLICY_ID=https://facturaelectronica.dian.gov.co/politicadefirma/v2/politicadefirmav2.pdf

# Fabricante del software, para la extensión del documento equivalente P.O.S.
# Es quien HIZO el software, no quien emite: vale igual para todos los emisores
# de la instalación. Tiene defaults en settings, así que solo hace falta
# definirlas si la instalación es de otro fabricante.
DIAN_FABRICANTE_NOMBRE=Mario A. Estrada
DIAN_FABRICANTE_RAZON_SOCIAL=Semantica Digital S.A.S
DIAN_FABRICANTE_NOMBRE_SOFTWARE=RedEDoc

# --- Almacenamiento Backblaze B2 (S3-compatible) ---
# OBLIGATORIO para subir certificados .p12: el material criptográfico se
# guarda siempre en B2 (dev y prod), nunca en disco local. Si faltan estas
# variables, la API rechaza la carga de certificados.
B2_BUCKET=
B2_ENDPOINT_URL=  # p.ej. https://s3.us-west-004.backblazeb2.com
B2_REGION=        # p.ej. us-west-004
B2_KEY_ID=        # keyID (access key)
B2_APP_KEY=       # applicationKey (secret key)

# --- Cifrado de la clave del certificado ---
# OBLIGATORIA: sin ella el proyecto no arranca. Con ella se cifra en la base la
# clave del .p12 de cada emisor (emi_certificado.clave), de modo que un volcado
# de la base no baste para firmar. Se genera con:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Va aparte de DJANGO_SECRET_KEY: rotar la SECRET_KEY invalida los JWT, y no
# puede además dejar ilegibles las claves de todos los certificados.
CERT_ENCRYPTION_KEY=

# --- Límites de peticiones (throttling) ---
# Por credencial autenticada y por el borde anónimo. Se suben sin desplegar
# código el día que un punto de venta con muchas cajas se quede corto.
THROTTLE_USUARIO=300/hour
THROTTLE_ANONIMO=30/hour

# --- Sentry (errores) ---
# Vacío = desactivado, que es lo normal en desarrollo. Con DSN se envían las
# excepciones no controladas y todo lo que se registre a nivel ERROR; los
# rechazos de la DIAN no generan eventos, solo contexto. Ver config/observabilidad.py.
SENTRY_DSN=
SENTRY_ENTORNO=produccion
# Muestreo de trazas de rendimiento: 0.0 desactiva, 0.1 sería una de cada diez.
SENTRY_TRACES=0.0
# Opcional: identifica la versión desplegada en Sentry (p. ej. el SHA del commit).
SENTRY_RELEASE=
