# Python
__pycache__/
*.py[cod]
*.egg-info/
.Python
build/
dist/

# Entornos virtuales
# Sin barra final a propósito: aquí `.venv` es un symlink a ~/.venvs/nobelio,
# y `.venv/` solo casaría con un directorio de verdad.
.venv
venv/
env/

# Django
*.log
/staticfiles/
/media/
# Base local de pruebas rápidas (ver DATABASE_URL en .env.example).
*.sqlite3
db.sqlite3

# Entorno / secretos
# `.env.example` SÍ se versiona: es la plantilla. `.env` nunca.
.env
.env.local
.env.*.local

# Capturas de tráfico DIAN: apps/dian/soap.DIRECTORIO_CAPTURA vuelca ahí los
# sobres SOAP transmitidos, que llevan el documento firmado y el certificado.
/capturas/
*-enviado.xml
*-respuesta.xml

# Certificados y llaves (NUNCA versionar)
